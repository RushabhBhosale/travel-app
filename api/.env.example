# Copy to api/.env (local) or set these in your host's dashboard (e.g. Render → Environment).
MONGO_URI=mongodb+srv://USER:PASSWORD@cluster.mongodb.net/travel
GMAIL_USER=you@gmail.com
GMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx
GOOGLE_API_KEY=
OPENROUTER_API_KEY=
# Optional: comma separated OpenRouter model ids, tried in order
# OPENROUTER_MODELS=google/gemma-4-31b-it:free,nvidia/nemotron-3-super-120b-a12b:free
# Sign-in tokens are verified with Clerk's public keys; no secret needed.
# Optional: publishable key of the Clerk app (defaults to the one the mobile app uses)
# CLERK_PUBLISHABLE_KEY=pk_test_...
# Optional: lets the server look up users' email/name from Clerk
# CLERK_SECRET_KEY=sk_test_...
PORT=3000
